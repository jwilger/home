#!/usr/bin/env python3
"""Keep installed bundle hashes accurate after Nix ELF fixups."""
import argparse
import hashlib
import json
import pathlib
import shutil


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def refresh(root):
    voice = root / 'codex-resources/voice'
    runtime_path = voice / 'runtime.json'
    manifest_path = voice / 'manifest.json'
    for path in [runtime_path, manifest_path]:
        receipt = path.with_suffix('.upstream.json')
        if not receipt.exists():
            shutil.copyfile(path, receipt)
    runtime = json.loads(runtime_path.read_text())
    for library in runtime['libraries']:
        # sourceSha256 remains the upstream receipt; sha256 describes the
        # installed ELF file after interpreter/RPATH changes.
        library['sha256'] = digest(voice / library['path'])
    runtime_path.write_text(json.dumps(runtime, indent=2) + '\n')
    manifest = json.loads(manifest_path.read_text())
    for name in manifest['sha256']:
        manifest['sha256'][name] = digest(root / name)
    manifest_path.write_text(json.dumps(manifest, indent=2) + '\n')


def verify(root):
    voice = root / 'codex-resources/voice'
    runtime = json.loads((voice / 'runtime.json').read_text())
    manifest = json.loads((voice / 'manifest.json').read_text())
    for library in runtime['libraries']:
        if library['sha256'] != digest(voice / library['path']):
            raise ValueError(f"Installed runtime hash mismatch: {library['path']}")
    for name, expected in manifest['sha256'].items():
        if expected != digest(root / name):
            raise ValueError(f'Installed bundle hash mismatch: {name}')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('root', type=pathlib.Path)
    parser.add_argument('--verify', action='store_true')
    args = parser.parse_args()
    if args.verify:
        verify(args.root)
    else:
        refresh(args.root)
