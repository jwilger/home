#!/usr/bin/env bash
set -euo pipefail

repository="$(git rev-parse --show-toplevel)"
source_config="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
source_state="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia"
destination="$repository/modules/home/desktop/noctalia"

install -m 0644 "$source_config/config.toml" "$destination/config.toml"
install -m 0644 "$source_state/settings.toml" "$destination/settings.toml"

echo "Captured the safe Noctalia baseline allowlist. Review the uncommitted Git diff."
echo "Generated state and plugins/github-feed/settings.json were not copied."
